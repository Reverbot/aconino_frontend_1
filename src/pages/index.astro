---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/home/HomePage.astro';
import { getImage } from 'astro:assets';
import imgHeroBg from '../assets/images/hero-background-blue.png';

const optimizedHeroBg = await getImage({ src: imgHeroBg, format: 'webp', width: 800 });
const siteUrl = Astro.site ?? new URL('https://www.aconino.org/');
const organizationUrl = new URL('/', siteUrl).toString().replace(/\/$/, '');

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${organizationUrl}/#organization`,
      "name": "Asociación Aconiño",
      "url": organizationUrl,
      "logo": new URL('/images/logo_aconino.png', siteUrl).toString(),
      "description": "Más de 35 años apoyando la inclusión y mejorando la calidad de vida de niños y jóvenes con discapacidad.",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+573133910760",
        "contactType": "Atención al cliente",
        "areaServed": "CO",
        "availableLanguage": "Spanish"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${organizationUrl}/#website`,
      "url": organizationUrl,
      "name": "Asociación Aconiño",
      "publisher": {
        "@id": `${organizationUrl}/#organization`
      }
    }
  ]
};
---
<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <link rel="preload" as="image" href={optimizedHeroBg.src} fetchpriority="high" />
  </Fragment>
  <Home />
</BaseLayout>
