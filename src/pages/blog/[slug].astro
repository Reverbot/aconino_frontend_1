---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostPage from '../../components/blog/BlogPostPage.astro';
import { blogPosts } from '../../data/blog';

export function getStaticPaths() {
  return blogPosts.map(({ slug }) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = blogPosts.find((p) => p.slug === slug);

const title = post ? `${post.title} | Asociación Aconiño` : "Artículo | Asociación Aconiño";
const description = post ? post.excerpt : "Artículo de la Asociación Aconiño.";
const imageUrl = post ? post.image : undefined;

const schema = post ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.excerpt,
  "image": `https://aconino.org${post.image}`,
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Organization",
    "name": "Asociación Aconiño",
    "url": "https://aconino.org"
  }
} : null;
---
<BaseLayout title={title} description={description} image={imageUrl}>
  {schema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    </Fragment>
  )}
  <BlogPostPage slug={slug || 'importancia-del-juego-en-el-neurodesarrollo'} />
</BaseLayout>
