---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostPage from '../../components/blog/BlogPostPage.astro';
import { isBlogPostPublished } from '../../data/blog';

export async function getStaticPaths() {
  const blogEntries = (await getCollection('blog')).filter((entry: CollectionEntry<'blog'>) =>
    !entry.data.draft && isBlogPostPublished(entry.data.publishedAt)
  );
  return blogEntries.map((entry: CollectionEntry<'blog'>) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

interface Props { entry: CollectionEntry<'blog'>; slug: string; }
const { entry, slug } = Astro.props;
const { Content } = await render(entry);

const title = `${entry.data.seoTitle || entry.data.title} | Asociación Aconiño`;
const description = entry.data.seoDescription || entry.data.excerpt;
const socialImage = await getImage({ src: entry.data.image, width: 1200, format: 'webp' });
const imageUrl = socialImage.src;
const authorName = entry.data.author || 'Asociación Aconiño';
const siteUrl = Astro.site ?? new URL('https://www.aconino.org/');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": description,
  "image": new URL(imageUrl, siteUrl).toString(),
  "datePublished": entry.data.publishedAt.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonical
  },
  "author": {
    "@type": "Organization",
    "name": authorName,
    "url": siteUrl.toString()
  }
};
---
<BaseLayout title={title} description={description} image={imageUrl} canonical={canonical} ogType="article">
  {schema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    </Fragment>
  )}
  <BlogPostPage entry={entry} slug={slug}>
    <Content />
  </BlogPostPage>
</BaseLayout>
