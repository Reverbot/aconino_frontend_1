---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostPage from '../../components/blog/BlogPostPage.astro';

export async function getStaticPaths() {
  const blogEntries = (await getCollection('blog')).filter((entry: CollectionEntry<'blog'>) => !entry.data.draft);
  return blogEntries.map((entry: CollectionEntry<'blog'>) => {
    const slug = entry.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

interface Props { entry: CollectionEntry<'blog'>; slug: string; }
const { entry, slug } = Astro.props;
const { Content } = await render(entry);

const title = `${entry.data.seoTitle || entry.data.title} | Asociación Aconiño`;
const description = entry.data.seoDescription || entry.data.excerpt;
const imageUrl = entry.data.image.src;
const authorName = entry.data.author || 'Asociación Aconiño';

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": entry.data.title,
  "description": description,
  "image": `https://aconino.org${imageUrl}`,
  "datePublished": entry.data.publishedAt,
  "author": {
    "@type": "Organization",
    "name": authorName,
    "url": "https://aconino.org"
  }
};
---
<BaseLayout title={title} description={description} image={imageUrl}>
  {schema && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    </Fragment>
  )}
  <BlogPostPage entry={entry} slug={slug}>
    <Content />
  </BlogPostPage>
</BaseLayout>
