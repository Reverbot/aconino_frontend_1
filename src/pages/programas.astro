---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgramasPage from '../components/programs/ProgramasPage.astro';
---
<BaseLayout title="Programas - Asociación Aconiño" description="Programas de atención integral y neurorehabilitación.">
  <ProgramasPage />

  <script is:inline>
    (() => {
      const setupProgramControls = () => {
        document.querySelectorAll('[data-program-timeline]').forEach((timeline) => {
          const cards = Array.from(timeline.querySelectorAll('[data-timeline-card]'));
          const dots = Array.from(timeline.querySelectorAll('[data-timeline-dot]'));
          const previous = timeline.querySelector('[data-timeline-prev]');
          const next = timeline.querySelector('[data-timeline-next]');
          const progress = timeline.querySelector('[data-timeline-progress]');
          const status = timeline.querySelector('[data-timeline-status]');
          let currentIndex = 0;

          const renderTimeline = (nextIndex) => {
            currentIndex = Math.max(0, Math.min(nextIndex, cards.length - 1));
            cards.forEach((card, index) => {
              const active = index === currentIndex;
              card.classList.toggle('hidden', !active);
              card.setAttribute('aria-hidden', String(!active));
            });
            dots.forEach((dot, index) => {
              const active = index === currentIndex;
              dot.classList.toggle('w-10', active);
              dot.classList.toggle('bg-primary', active);
              dot.classList.toggle('w-2', !active);
              dot.classList.toggle('bg-gray-200', !active);
              dot.setAttribute('aria-current', active ? 'step' : 'false');
            });
            if (previous) previous.disabled = currentIndex === 0;
            if (next) next.disabled = currentIndex === cards.length - 1;
            if (progress) progress.style.width = `${((currentIndex + 1) / cards.length) * 100}%`;
            if (status) status.textContent = `Paso ${currentIndex + 1} de ${cards.length}`;
          };

          previous?.addEventListener('click', () => renderTimeline(currentIndex - 1));
          next?.addEventListener('click', () => renderTimeline(currentIndex + 1));
          dots.forEach((dot) => dot.addEventListener('click', () => renderTimeline(Number(dot.dataset.index))));
          renderTimeline(0);
        });

        document.querySelectorAll('[data-objectives-tabs]').forEach((tabs) => {
          const tabButtons = Array.from(tabs.querySelectorAll('[data-objective-tab]'));
          const desktopPanels = Array.from(tabs.querySelectorAll('[data-objectives-desktop] [data-objectives-panel]'));
          const mobilePanels = Array.from(tabs.querySelectorAll('[data-objectives-mobile-panel]'));
          let activeTab = tabButtons[0]?.dataset.objectiveTab;

          const renderMobilePanel = (panel, index) => {
            if (!panel) return;
            const items = JSON.parse(panel.dataset.objectiveItems || '[]');
            const safeIndex = Math.max(0, Math.min(index, items.length - 1));
            panel.dataset.objectiveIndex = String(safeIndex);
            const copy = panel.querySelector('[data-objective-mobile-copy]');
            const number = panel.querySelector('[data-objective-mobile-number]');
            const status = panel.querySelector('[data-objective-mobile-status]');
            const previous = panel.querySelector('[data-objective-prev]');
            const next = panel.querySelector('[data-objective-next]');
            if (copy) copy.textContent = items[safeIndex] || 'Sin objetivos registrados';
            if (number) number.textContent = String(safeIndex + 1);
            if (status) status.textContent = `${safeIndex + 1} / ${items.length}`;
            if (previous) previous.disabled = safeIndex === 0;
            if (next) next.disabled = safeIndex >= items.length - 1;
          };

          const renderObjectives = (tabId) => {
            activeTab = tabId;
            tabButtons.forEach((button) => {
              const active = button.dataset.objectiveTab === activeTab;
              button.setAttribute('aria-selected', String(active));
              button.classList.toggle('bg-primary', active);
              button.classList.toggle('text-white', active);
              button.classList.toggle('shadow-lg', active);
              button.classList.toggle('shadow-primary/20', active);
              button.classList.toggle('text-gray-500', !active);
            });
            desktopPanels.forEach((panel) => {
              const active = panel.dataset.objectivesPanel === activeTab;
              panel.classList.toggle('hidden', !active);
              panel.classList.toggle('grid', active);
            });
            mobilePanels.forEach((panel) => {
              const active = panel.dataset.objectivesMobilePanel === activeTab;
              panel.classList.toggle('hidden', !active);
              if (active) renderMobilePanel(panel, Number(panel.dataset.objectiveIndex || 0));
            });
          };

          tabButtons.forEach((button) => button.addEventListener('click', () => renderObjectives(button.dataset.objectiveTab)));
          mobilePanels.forEach((panel) => {
            panel.querySelector('[data-objective-prev]')?.addEventListener('click', () => renderMobilePanel(panel, Number(panel.dataset.objectiveIndex || 0) - 1));
            panel.querySelector('[data-objective-next]')?.addEventListener('click', () => renderMobilePanel(panel, Number(panel.dataset.objectiveIndex || 0) + 1));
            renderMobilePanel(panel, 0);
          });
          if (activeTab) renderObjectives(activeTab);
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupProgramControls, { once: true });
      } else {
        setupProgramControls();
      }
    })();
  </script>
</BaseLayout>
