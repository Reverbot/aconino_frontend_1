---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada | Aconiño" noindex>
  <section class="relative flex min-h-[70vh] w-full items-center justify-center overflow-hidden bg-white py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -right-[5%] -top-[10%] h-[600px] w-[600px] rounded-full bg-primary/5 blur-[120px]"></div>
      <div class="absolute -left-[5%] top-[40%] h-[500px] w-[500px] rounded-full bg-accent/5 blur-[100px]"></div>
    </div>
    
    <div class="relative z-10 mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8 reveal-on-scroll">
      <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-white shadow-xl shadow-primary/10 md:h-32 md:w-32">
        <span class="text-5xl font-black text-primary md:text-7xl">404</span>
      </div>
      <div class="mx-auto mb-6 h-1 w-16 rounded-full bg-accent"></div>
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-primary md:text-5xl lg:text-6xl">Página no encontrada</h1>
      <p class="mx-auto mb-10 max-w-lg text-base font-medium leading-relaxed text-slate-500 md:text-lg">
        Lo sentimos, no pudimos encontrar la página que buscas. Es posible que el enlace sea incorrecto o que la página haya sido movida.
      </p>
      <a href="/" class="kowalski-btn inline-block rounded-full bg-accent px-10 py-4 text-sm font-bold tracking-widest text-primary shadow-xl shadow-accent/20 transition-all hover:-translate-y-1 hover:scale-105 hover:bg-primary hover:text-white md:text-base">
        VOLVER AL INICIO
      </a>
    </div>
  </section>
</BaseLayout>
