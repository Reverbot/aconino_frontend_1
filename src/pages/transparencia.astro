---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentosLegalesPage from '../components/legal/DocumentosLegalesPage.astro';

const documentos = [
  { id: 'informe-gestion-2024', titulo: 'Informe de gestión 2024', archivoUrl: '/documents/informe-gestion-2024.pdf' },
  { id: 'estados-financieros-2024', titulo: 'Estados financieros 2024-2023', archivoUrl: '/documents/estados-financieros-2024-2023.pdf' },
  { id: 'certificado-legal', titulo: 'Certificado de existencia y representación legal', archivoUrl: '/documents/certificado-existencia-representacion-legal.pdf' },
  { id: 'estatutos', titulo: 'Estatutos de la Asociación Aconiño', archivoUrl: '/documents/estatutos-aconino.pdf' },
];
---
<BaseLayout title="Transparencia y Ética - Asociación Aconiño" description="Conoce el Canal de Transparencia y Ética de Aconiño, reporta situaciones a transparenciayetica@aconino.org y consulta nuestra información pública.">
  <DocumentosLegalesPage
    titulo="Transparencia"
    subtitulo="Información Pública"
    descripcion="Documentos de transparencia e información pública conforme a la normativa vigente."
    categoria="transparencia"
    icono="📋"
    documentos={documentos}
  >
    <section id="canal-transparencia-etica" aria-labelledby="canal-title" class="mb-12 scroll-mt-44">
      <h2 id="canal-title" class="mb-6 text-2xl font-extrabold text-primary md:text-3xl">Canal de Transparencia y Ética</h2>
      <div class="space-y-5 text-base leading-relaxed text-gray-600 md:text-lg">
        <p>En Aconiño acompañamos procesos de rehabilitación infantil y trabajamos para que niños, familias, colaboradores y aliados encuentren un entorno seguro, respetuoso y confiable.</p>
        <p>Como parte de nuestro Programa de Transparencia y Ética Empresarial, contamos con un canal para reportar situaciones que puedan ir en contra de nuestros principios, normas institucionales o buenas prácticas, como posibles conflictos de interés, irregularidades, uso inadecuado de recursos o conductas que afecten la integridad de nuestra organización.</p>
      </div>
      <div class="my-8 rounded-xl bg-primary/5 p-5 md:p-7">
        <p class="mb-3 leading-relaxed text-primary">Si conoces alguna situación que deba ser revisada, puedes escribirnos a:</p>
        <a href="mailto:transparenciayetica@aconino.org" class="inline-flex max-w-full items-center gap-3 rounded-sm py-2 text-base font-bold text-primary underline decoration-accent decoration-2 underline-offset-4 transition-colors hover:text-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary md:text-xl">
          <svg class="h-6 w-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" /></svg>
          <span class="min-w-0 break-words">transparenciayetica@aconino.org</span>
        </a>
      </div>
      <p class="text-base leading-relaxed text-gray-600 md:text-lg">Cada reporte contribuye a fortalecer una cultura de responsabilidad, transparencia y cuidado dentro de Aconiño.</p>
    </section>
    <h2 class="mb-6 border-t border-gray-200 pt-8 text-2xl font-bold text-primary">Documentos de transparencia</h2>
  </DocumentosLegalesPage>
</BaseLayout>
