---
const situationOptions = [
  'Fraude, corrupción o soborno',
  'Conflicto de interés no informado',
  'Uso inadecuado de recursos, bienes, aportes o donaciones',
  'Alteración, falsificación u ocultamiento de documentos o información',
  'Irregularidad administrativa, financiera, contractual o asistencial',
  'Acoso laboral, acoso sexual, maltrato o discriminación',
  'Conducta que afecta la dignidad, seguridad o integridad de una persona',
  'Uso indebido o divulgación no autorizada de información confidencial o datos personales',
  'Incumplimiento de normas, protocolos o políticas institucionales',
  'Represalias por presentar un reporte o participar en su revisión',
  'Otro',
];

const vinculationOptions = [
  'Niño, niña o adolescente / familia',
  'Colaborador o excolaborador',
  'Proveedor o contratista',
  'Aliado o entidad relacionada',
  'Visitante o tercero',
  'Prefiero no decirlo',
];

const legalDocuments = [
  { id: 'autorizacion-datos', title: 'Autorización para el tratamiento de datos personales', href: '/documents/autorizacion-tratamiento-datos-canal-etica-aconino.pdf' },
  { id: 'terminos-canal', title: 'Términos y condiciones de uso del canal', href: '/documents/terminos-condiciones-canal-etica-aconino.pdf' },
  { id: 'politica-datos', title: 'Política de tratamiento de datos personales', href: '/documents/politica-tratamiento-datos-personales-aconino.pdf' },
];
---

<form
  id="reporte-etica-form"
  class="report-form"
  action="/api/reporte-etica"
  method="POST"
  enctype="multipart/form-data"
  data-report-form
  novalidate
>
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only" />

  <div class="report-form__intro">
    <div>
      <span class="report-form__eyebrow">Formulario de denuncia</span>
      <h2 id="formulario-title">Comparte la situación que deseas reportar</h2>
    </div>
    <p><span aria-hidden="true">*</span> Los campos marcados son obligatorios. Puedes enviar el reporte de manera identificada o anónima.</p>
  </div>

  <fieldset class="report-form__section">
    <legend><span class="report-form__number">01</span> ¿Cómo deseas presentar tu reporte?</legend>
    <p class="report-form__help">Elige si quieres dejarnos tus datos o prefieres reportar sin identificarte.</p>
    <div class="report-form__choice-grid">
      <label class="report-form__choice">
        <input type="radio" name="modalidad_reporte" value="Identificado" checked required data-reporter-mode="identified" />
        <span><strong>Reporte identificado</strong><small>Podremos contactarte si necesitamos ampliar la información.</small></span>
      </label>
      <label class="report-form__choice">
        <input type="radio" name="modalidad_reporte" value="Anónimo" data-reporter-mode="anonymous" />
        <span><strong>Reporte anónimo</strong><small>No es necesario compartir nombre, teléfono ni correo.</small></span>
      </label>
    </div>
  </fieldset>

  <fieldset class="report-form__section" data-reporter-details>
    <legend><span class="report-form__number">02</span> Datos de quien reporta</legend>
    <p class="report-form__help">Estos datos son opcionales, pero pueden ayudarnos a hacer seguimiento.</p>
    <div class="report-form__grid report-form__grid--two">
      <div class="report-form__field"><label for="reporter-name">Nombre completo</label><input id="reporter-name" name="nombre_reportante" type="text" autocomplete="name" placeholder="Escribe tu nombre completo" /></div>
      <div class="report-form__field"><label for="reporter-relation">Tipo de vinculación</label><select id="reporter-relation" name="vinculacion_reportante"><option value="">Selecciona una opción</option>{vinculationOptions.map((option) => <option value={option}>{option}</option>)}</select></div>
      <div class="report-form__field"><label for="reporter-email">Correo electrónico</label><input id="reporter-email" name="_replyto" type="email" autocomplete="email" placeholder="tu@correo.com" /></div>
      <div class="report-form__field"><label for="reporter-phone">Teléfono o celular</label><input id="reporter-phone" name="telefono_reportante" type="tel" autocomplete="tel" placeholder="Ej. 313 000 0000" /></div>
    </div>
  </fieldset>

  <fieldset class="report-form__section">
    <legend><span class="report-form__number">03</span> Sobre la situación reportada</legend>
    <p class="report-form__help">Comparte los hechos de forma clara. No necesitas tener todas las pruebas para informar una situación.</p>
    <div class="report-form__grid report-form__grid--two">
      <div class="report-form__field report-form__field--full"><label for="reporter-situation">Tipo de situación <span aria-hidden="true">*</span></label><select id="reporter-situation" name="tipo_situacion" required><option value="">Selecciona el tipo de situación</option>{situationOptions.map((option) => <option value={option}>{option}</option>)}</select></div>
      <div class="report-form__field report-form__field--full" data-other-situation hidden><label for="other-situation">Describe brevemente el tipo de situación</label><input id="other-situation" name="otra_situacion" type="text" placeholder="Escribe una categoría" /></div>
      <div class="report-form__field"><label for="incident-date">Fecha del incidente <span aria-hidden="true">*</span></label><input id="incident-date" name="fecha_incidente" type="date" required /></div>
      <div class="report-form__field"><label for="incident-place">Lugar, sede o área</label><input id="incident-place" name="lugar_area" type="text" placeholder="Ej. sede, proceso o área" /></div>
      <div class="report-form__field"><label for="incident-start">Si se extendió en el tiempo, ¿desde cuándo?</label><input id="incident-start" name="fecha_inicio" type="date" /></div>
      <div class="report-form__field"><label for="incident-end">¿Hasta cuándo ocurrió aproximadamente?</label><input id="incident-end" name="fecha_fin" type="date" /></div>
      <div class="report-form__field report-form__field--full"><label for="involved-people">Personas, cargos o áreas involucradas</label><textarea id="involved-people" name="personas_involucradas" rows="3" placeholder="Indica nombres, cargos o áreas. Si no los conoces, escribe “No lo conozco”."></textarea></div>
      <div class="report-form__field report-form__field--full"><label for="incident-description">¿En qué consistió la situación? <span aria-hidden="true">*</span></label><textarea id="incident-description" name="descripcion_hechos" rows="7" required placeholder="Cuéntanos qué ocurrió, cómo lo conociste y qué personas o procesos podrían verse afectados."></textarea><small class="report-form__hint">Diferencia, cuando sea posible, lo que viste directamente de lo que te fue contado.</small></div>
      <div class="report-form__field report-form__field--full"><label for="incident-impact">¿La situación puede afectar a personas, niños, familias o procesos de Aconiño?</label><textarea id="incident-impact" name="posible_impacto" rows="3" placeholder="Describe el posible impacto o escribe “No lo sé”."></textarea></div>
      <div class="report-form__field report-form__field--full"><label for="reporter-motivation">¿Qué te motivó a reportar la situación?</label><textarea id="reporter-motivation" name="motivacion_reporte" rows="3" placeholder="Cuéntanos qué esperas que revisemos."></textarea></div>
    </div>
  </fieldset>

  <fieldset class="report-form__section">
    <legend><span class="report-form__number">04</span> Soportes y seguimiento</legend>
    <div class="report-form__field"><label for="report-files">Adjuntar soportes</label><input id="report-files" name="archivos" type="file" multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xls,.xlsx,.mp4,.mp3,.avi" data-report-files /><small class="report-form__hint">Puedes adjuntar fotografías, documentos o capturas de pantalla. Máximo total: 4 MB. No envíes información sensible que no sea indispensable.</small><p class="report-form__file-status" data-file-status aria-live="polite">No has seleccionado archivos.</p></div>
    <div class="report-form__field report-form__field--full"><label for="follow-up">¿Hay algo más que debamos saber?</label><textarea id="follow-up" name="informacion_adicional" rows="4" placeholder="Incluye cualquier dato adicional que ayude a revisar el caso."></textarea></div>
  </fieldset>

  <fieldset class="report-form__section report-form__section--legal">
    <legend><span class="report-form__number">05</span> Autorizaciones y envío</legend>
    <p class="report-form__help">Lee cada documento antes de marcar las casillas. Los enlaces se abren en una nueva pestaña.</p>
    <div class="report-form__legal-list">{legalDocuments.map((document) => <label class="report-form__legal-item"><input type="checkbox" name={`acepta_${document.id}`} value="Sí" required /><span>He leído y acepto la <a href={document.href} target="_blank" rel="noopener noreferrer">{document.title}</a>.</span></label>)}</div>
    <label class="report-form__consent"><input type="checkbox" name="declara_buena_fe" value="Sí" required /><span>Declaro que presento este reporte de buena fe y que la información que comparto es clara según mi conocimiento.</span></label>
    <div class="report-form__actions"><button type="submit" class="report-form__submit"><span>Enviar reporte</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg></button><p class="report-form__delivery">La información se enviará al correo <a href="mailto:transparenciayetica@aconino.org">transparenciayetica@aconino.org</a>.</p></div>
    <p class="report-form__error" data-form-error role="alert" hidden></p>
  </fieldset>
</form>

<script>
  const initialiseReportForm = () => {
    const form = document.querySelector('[data-report-form]');
    if (!(form instanceof HTMLFormElement) || form.dataset.initialised === 'true') return;
    form.dataset.initialised = 'true';
    const reporterDetails = form.querySelector('[data-reporter-details]');
    const reporterInputs = reporterDetails?.querySelectorAll('input, select') ?? [];
    const otherSituation = form.querySelector('[data-other-situation]');
    const situationSelect = form.querySelector('#reporter-situation');
    const fileInput = form.querySelector('[data-report-files]');
    const fileStatus = form.querySelector('[data-file-status]');
    const errorMessage = form.querySelector('[data-form-error]');
    const submitButton = form.querySelector('button[type="submit"]');
    const submitLabel = submitButton?.querySelector('span');
    const maxFileSize = 4 * 1024 * 1024;
    let isSubmitting = false;

    const syncReporterMode = (mode) => {
      const anonymous = mode === 'anonymous';
      reporterDetails?.toggleAttribute('hidden', anonymous);
      reporterInputs.forEach((input) => {
        if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement) input.disabled = anonymous;
      });
    };

    form.querySelectorAll('[data-reporter-mode]').forEach((input) => input.addEventListener('change', () => {
      if (input instanceof HTMLInputElement && input.checked) syncReporterMode(input.dataset.reporterMode);
    }));

    situationSelect?.addEventListener('change', () => {
      const showOther = situationSelect.value === 'Otro';
      otherSituation?.toggleAttribute('hidden', !showOther);
      const otherInput = otherSituation?.querySelector('input');
      if (otherInput) { otherInput.required = showOther; if (!showOther) otherInput.value = ''; }
    });

    fileInput?.addEventListener('change', () => {
      if (!(fileInput instanceof HTMLInputElement) || !fileStatus) return;
      const files = Array.from(fileInput.files ?? []);
      const totalSize = files.reduce((total, file) => total + file.size, 0);
      fileStatus.textContent = files.length === 0 ? 'No has seleccionado archivos.' : `${files.length} archivo${files.length === 1 ? '' : 's'} seleccionado${files.length === 1 ? '' : 's'} · ${(totalSize / (1024 * 1024)).toFixed(1)} MB`;
      fileStatus.classList.toggle('is-error', totalSize > maxFileSize);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isSubmitting) return;
      if (!form.checkValidity()) {
        form.classList.add('has-validation-error');
        if (errorMessage) { errorMessage.textContent = 'Revisa los campos obligatorios y las autorizaciones antes de enviar el reporte.'; errorMessage.removeAttribute('hidden'); }
        form.querySelector(':invalid')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (fileInput instanceof HTMLInputElement) {
        const totalSize = Array.from(fileInput.files ?? []).reduce((total, file) => total + file.size, 0);
        if (totalSize > maxFileSize) {
          if (errorMessage) { errorMessage.textContent = 'Los archivos superan el máximo total de 4 MB. Elimina alguno e inténtalo de nuevo.'; errorMessage.removeAttribute('hidden'); }
          fileInput.focus();
          return;
        }
      }
      errorMessage?.setAttribute('hidden', 'true');
      isSubmitting = true;
      form.setAttribute('aria-busy', 'true');
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Enviando...';

      try {
        const response = await fetch(form.getAttribute('action') || '/api/reporte-etica', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || 'No fue posible enviar el reporte.');
        window.location.href = '/reporte-etica?enviado=1';
      } catch (error) {
        if (errorMessage) {
          errorMessage.textContent = error instanceof Error ? error.message : 'No fue posible enviar el reporte. Inténtalo nuevamente.';
          errorMessage.removeAttribute('hidden');
        }
      } finally {
        isSubmitting = false;
        form.removeAttribute('aria-busy');
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = 'Enviar reporte';
      }
    });
    syncReporterMode('identified');
  };
  document.addEventListener('astro:page-load', initialiseReportForm);
  initialiseReportForm();
</script>

<style>
  .report-form { --form-ink: #0c2070; --form-muted: #52617f; --form-line: #dce3ef; --form-surface: #f8faff; position: relative; overflow: hidden; border: 1px solid rgba(12, 32, 112, 0.12); border-radius: 1.5rem; background: #fff; box-shadow: 0 24px 60px rgba(12, 32, 112, 0.1); }
  .report-form__intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding: 2rem; background: linear-gradient(135deg, var(--form-ink), #365ca1); color: #fff; }
  .report-form__intro h2 { max-width: 28rem; margin: 0.5rem 0 0; font-size: clamp(1.65rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.03em; }
  .report-form__intro p { max-width: 22rem; margin: 0; color: rgba(255,255,255,.82); font-size: .9rem; line-height: 1.55; }
  .report-form__intro p span, .report-form__eyebrow { color: #f8b719; }
  .report-form__eyebrow { font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .report-form__section { margin: 0; padding: 2rem; border: 0; border-bottom: 1px solid var(--form-line); }
  .report-form__section:last-child { border-bottom: 0; }
  .report-form__section legend { display: flex; align-items: center; gap: .75rem; float: left; width: 100%; margin-bottom: .6rem; color: var(--form-ink); font-size: 1.15rem; font-weight: 800; }
  .report-form__section legend + * { clear: both; }
  .report-form__number { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border-radius: .65rem; background: rgba(248,183,25,.18); color: var(--form-ink); font-size: .72rem; letter-spacing: .06em; }
  .report-form__help { margin: 0 0 1.5rem; color: var(--form-muted); font-size: .9rem; line-height: 1.55; }
  .report-form__choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .9rem; }
  .report-form__choice { display: flex; align-items: flex-start; gap: .8rem; min-height: 7rem; padding: 1rem; border: 1px solid var(--form-line); border-radius: .85rem; background: var(--form-surface); cursor: pointer; transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease; }
  .report-form__choice:has(input:checked) { border-color: var(--form-ink); background: #fff; box-shadow: 0 8px 20px rgba(12,32,112,.08); }
  .report-form__choice input, .report-form__legal-item input, .report-form__consent input { margin-top: .25rem; accent-color: var(--form-ink); }
  .report-form__choice strong { display: block; color: var(--form-ink); font-size: .95rem; }
  .report-form__choice small { display: block; margin-top: .35rem; color: var(--form-muted); font-size: .78rem; line-height: 1.45; }
  .report-form__grid { display: grid; gap: 1.15rem; }
  .report-form__grid--two { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .report-form__field { min-width: 0; }
  .report-form__field--full { grid-column: 1 / -1; }
  .report-form__field label { display: block; margin-bottom: .45rem; color: var(--form-ink); font-size: .78rem; font-weight: 800; }
  .report-form__field label span { color: #bf4a3f; }
  .report-form__field input:not([type='file']), .report-form__field select, .report-form__field textarea { width: 100%; border: 1px solid var(--form-line); border-radius: .65rem; background: #fff; padding: .8rem .9rem; color: #1e2d4f; font: inherit; font-size: .88rem; outline: none; transition: border-color 180ms ease, box-shadow 180ms ease; }
  .report-form__field input:not([type='file']):focus, .report-form__field select:focus, .report-form__field textarea:focus { border-color: var(--form-ink); box-shadow: 0 0 0 3px rgba(12,32,112,.12); }
  .report-form__field textarea { min-height: 6rem; resize: vertical; }
  .report-form__field input::placeholder, .report-form__field textarea::placeholder { color: #7b88a1; }
  .report-form__field input[type='file'] { width: 100%; border: 1px dashed #aebbd2; border-radius: .65rem; background: var(--form-surface); padding: .8rem; color: var(--form-muted); font-size: .82rem; }
  .report-form__hint, .report-form__file-status { display: block; margin: .45rem 0 0; color: var(--form-muted); font-size: .75rem; line-height: 1.5; }
  .report-form__file-status.is-error { color: #a53b35; font-weight: 700; }
  .report-form__legal-list { display: grid; gap: .75rem; }
  .report-form__legal-item, .report-form__consent { display: flex; align-items: flex-start; gap: .65rem; color: var(--form-muted); font-size: .82rem; line-height: 1.5; }
  .report-form__legal-item a, .report-form__delivery a { color: var(--form-ink); font-weight: 800; text-decoration: underline; text-decoration-color: #f8b719; text-underline-offset: .16em; }
  .report-form__consent { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--form-line); }
  .report-form__actions { display: flex; align-items: center; gap: 1.25rem; margin-top: 1.75rem; }
  .report-form__submit { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; border: 0; border-radius: 999px; background: var(--form-ink); padding: .9rem 1.5rem; color: #fff; font: inherit; font-size: .85rem; font-weight: 800; cursor: pointer; transition: background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .report-form__submit svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .report-form__submit:hover { background: #365ca1; box-shadow: 0 10px 24px rgba(12,32,112,.18); transform: translateY(-1px); }
  .report-form__submit:focus-visible { outline: 3px solid rgba(248,183,25,.7); outline-offset: 3px; }
  .report-form__delivery { max-width: 26rem; margin: 0; color: var(--form-muted); font-size: .75rem; line-height: 1.5; }
  .report-form__error { margin: 1rem 0 0; color: #a53b35; font-size: .82rem; font-weight: 700; }
  .report-form.has-validation-error :invalid { border-color: #b94a43; }
  [data-other-situation][hidden], [data-reporter-details][hidden] { display: none; }
  @media (max-width: 700px) { .report-form__intro { display: block; padding: 1.5rem; } .report-form__intro p { margin-top: 1rem; } .report-form__section { padding: 1.5rem; } .report-form__choice-grid, .report-form__grid--two { grid-template-columns: 1fr; } .report-form__field--full { grid-column: auto; } .report-form__actions { display: block; } .report-form__submit { width: 100%; } .report-form__delivery { margin-top: .9rem; } }
</style>
