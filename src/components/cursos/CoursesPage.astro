---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { historyEvents, instructorGroups } from '../../data/courses';
import imgCursosHero from '../../assets/images/cursos-hero.jpg';

const courseList = await getCollection('cursos');
const formatStatus = (status?: string) => status === 'activo' ? 'Abierto' : status === 'proximamente' ? 'Próximamente' : status === 'finalizado' ? 'Finalizado' : '';
---

<main class="min-h-screen bg-white">
  <section class="relative h-[40vh] min-h-[360px] w-full overflow-hidden md:h-[45vh]">
    <Image src={imgCursosHero} alt="Cursos de formación en neurodesarrollo" class="h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/40 to-primary/80"></div><div class="absolute inset-0 bg-gradient-to-r from-primary/60 via-transparent to-transparent"></div>
    <div class="relative z-10 flex h-full flex-col items-center justify-center px-4 text-center"><span class="mb-6 rounded-full border border-accent/30 bg-accent/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-accent">Capacitación Profesional</span><h1 class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl" style="text-shadow: 0 2px 20px rgba(0,0,0,.3)">Cursos y Capacitaciones</h1><p class="mt-5 max-w-xl text-base font-medium leading-relaxed text-white/80 md:text-lg">Explora nuestros programas de formación en neurodesarrollo y certificación en metodologías especializadas.</p><span class="mt-6 text-4xl text-accent drop-shadow-lg md:text-5xl" aria-hidden="true">♥</span></div>
  </section>

  <section class="relative overflow-hidden bg-slate-50 py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0"><div class="absolute -left-[10%] top-[50%] h-[500px] w-[500px] rounded-full bg-primary/10 blur-[150px]"></div><div class="absolute -right-[15%] -top-[10%] h-[400px] w-[400px] rounded-full bg-accent/20 blur-[120px]"></div></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-20 max-w-3xl text-center md:mb-32"><span class="mb-6 inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold uppercase tracking-wider text-slate-600 shadow-sm"><span class="h-2 w-2 rounded-full bg-blue-600"></span>Nuestro Legado</span><h2 class="mb-6 text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl lg:text-6xl">Historia del Neurodesarrollo <span class="text-indigo-600">Bobath</span></h2><p class="text-xl leading-relaxed text-slate-600">Un recorrido de innovación y esperanza en la neurorehabilitación</p></div>
      <div class="relative mx-auto max-w-4xl"><div class="absolute bottom-0 left-[28px] top-0 w-1 rounded-full bg-slate-200 md:left-1/2 md:-translate-x-1/2"><div class="h-full w-full bg-gradient-to-b from-blue-600 via-indigo-500 to-purple-600"></div></div><div class="relative space-y-12 md:space-y-24">{historyEvents.map((item, index) => { const even = index % 2 === 0; return <div class="group relative flex flex-col items-start md:flex-row md:items-center"><div class:list={["w-full pl-20 md:w-1/2 md:pl-0", even ? 'md:justify-end md:pr-16' : 'md:order-last md:justify-start md:pl-16']}><div class="relative overflow-hidden rounded-[2rem] border border-slate-100 bg-white p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 group-hover:-translate-y-1 group-hover:shadow-[0_15px_45px_rgb(0,0,0,0.08)] md:rounded-[3rem]"><div class:list={["absolute -right-10 -top-10 h-32 w-32 rounded-full bg-gradient-to-br opacity-5 blur-2xl", item.color]}></div><span class="mb-4 inline-block rounded-full bg-slate-100 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-slate-600">{item.year}</span><h3 class="mb-4 text-2xl font-black leading-tight tracking-tight text-slate-900 md:text-3xl">{item.title}</h3><p class="font-medium leading-relaxed text-slate-600 md:text-lg">{item.description}</p></div></div><div class="absolute left-0 z-10 flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-4 border-slate-50 bg-white shadow-lg md:left-1/2 md:-translate-x-1/2"><div class:list={["absolute inset-0 bg-gradient-to-tr opacity-10", item.color]}></div><span class="relative text-lg font-black text-slate-800" aria-hidden="true">{index + 1}</span></div></div>})}</div></div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-[#F8FAFC] py-20 md:py-32">
    <div class="relative z-10 mx-auto max-w-[1440px] overflow-visible px-4 sm:px-6 lg:px-8"><div class="mb-24 border-b border-primary/10 pb-8"><div class="mb-4 flex items-center justify-center gap-3 text-sm font-black uppercase tracking-widest text-accent md:justify-start"><span class="hidden h-px w-8 bg-accent/30 md:block"></span><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>Agenda Académica</div><h2 class="text-center text-5xl font-black leading-none tracking-tighter text-primary md:text-left md:text-6xl lg:text-7xl">2026</h2></div><div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3 lg:gap-14">{courseList.map((course) => { const finished = course.data.status === 'finalizado'; const active = course.data.status === 'activo'; return <article id={course.slug} class="group relative flex h-full scroll-mt-32 flex-col">{course.data.featured && <div class="absolute -inset-1 rounded-[2.2rem] bg-gradient-to-r from-accent/40 to-primary/20 opacity-30 blur-xl transition duration-500 group-hover:opacity-50"></div>}<div class:list={["relative z-10 flex h-full flex-col overflow-hidden rounded-[2rem] border bg-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-shadow duration-500 group-hover:shadow-[0_25px_60px_rgba(0,0,0,0.12)]", course.data.featured ? 'border-accent/40 ring-1 ring-accent/20' : 'border-slate-100']}><div class="relative h-72 w-full overflow-hidden md:h-96"><Image src={course.data.image} alt={course.data.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" decoding="async" /><div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/20 to-transparent opacity-80 transition-opacity duration-300 group-hover:opacity-90"></div><div class="absolute left-4 right-4 top-4 z-10 flex items-start justify-between"><div>{formatStatus(course.data.status) && <span class:list={["rounded-full px-3 py-1.5 text-[10px] font-black uppercase tracking-widest shadow-lg", finished ? 'bg-slate-900/90 text-white' : active ? 'bg-emerald-500 text-white' : 'bg-accent text-primary']}>{formatStatus(course.data.status)}</span>}</div>{course.data.featured && <span class="flex items-center gap-1 rounded-full border border-accent bg-white px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-primary shadow-xl"><span class="text-accent" aria-hidden="true">★</span>Destacado</span>}</div></div><div class="flex flex-1 flex-col p-6 md:p-8"><h3 class="mb-5 line-clamp-2 text-xl font-black uppercase leading-tight tracking-tight text-primary transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent md:text-2xl">{course.data.title}</h3><div class="mb-6 space-y-4">{course.data.dates && <div class="flex items-center gap-3 text-sm font-bold text-slate-600"><span class="rounded-xl border border-slate-100 bg-slate-50 p-2 text-primary" aria-hidden="true">▣</span><span class="truncate tracking-tight">{course.data.dates}</span></div>}{course.data.location && <div class="flex items-center gap-3 text-sm font-bold text-slate-600"><span class="rounded-xl border border-slate-100 bg-slate-50 p-2 text-primary" aria-hidden="true">⌖</span><span class="truncate tracking-tight">{course.data.location} {course.data.countryCode === 'CO' ? '🇨🇴' : ''}</span></div>}{course.data.instructor && <div class="flex items-center gap-3 text-sm font-bold text-slate-600"><span class="rounded-xl border border-slate-100 bg-slate-50 p-2 text-primary" aria-hidden="true">●</span><span class="truncate">Por: <span class="text-primary">{course.data.instructor}</span></span></div>}</div>{course.data.description && <p class="mb-8 line-clamp-3 flex-1 text-sm font-medium leading-relaxed text-slate-500">{course.data.description}</p>}<a href="https://wa.me/573133910760" target="_blank" rel="noopener noreferrer" class:list={["group/btn flex w-full items-center justify-center gap-3 rounded-2xl px-6 py-5 text-center text-xs font-black uppercase tracking-widest shadow-sm transition-all duration-300", finished ? 'bg-slate-100 text-slate-400 hover:shadow-xl' : 'bg-primary text-white hover:-translate-y-1 hover:bg-secondary hover:shadow-xl']}>{finished ? 'Ver Histórico' : 'Inscribirse Ahora'}<span class="transition-transform group-hover/btn:translate-x-1" aria-hidden="true">→</span></a></div></div></article>})}</div><div class="mx-auto mt-16 max-w-4xl rounded-2xl border border-accent/20 bg-white/60 p-6 text-center shadow-sm backdrop-blur-md"><span class="mb-3 block text-3xl text-accent" aria-hidden="true">✦</span><h3 class="mb-2 text-xl font-black text-primary">¡Nuevos Cursos Pronto!</h3><p class="text-slate-500">Actualmente estamos preparando nuestra próxima oferta académica. Aquí puedes ver ejemplos de las formaciones de alta calidad que ofrecemos en Aconiño.</p></div></div><div class="pointer-events-none absolute bottom-0 right-0 hidden select-none overflow-hidden opacity-[0.03] lg:block"><span class="whitespace-nowrap text-[24rem] font-black leading-none tracking-tighter text-[#0a1f44]">ACN ACADEMY</span></div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-primary to-secondary py-20 text-center text-white"><div class="absolute left-1/4 top-1/4 h-64 w-64 rounded-full bg-accent/20 blur-[100px]"></div><div class="absolute bottom-1/4 right-1/4 h-64 w-64 rounded-full bg-white/10 blur-[100px]"></div><div class="relative z-10 mx-auto max-w-3xl px-4"><h2 class="mb-4 text-3xl font-extrabold md:text-4xl">¿Interesado en nuestros cursos?</h2><p class="mx-auto mb-8 max-w-xl text-lg text-white/80">Contáctanos para conocer las próximas fechas y disponibilidad de cupos.</p><a href="https://wa.me/573133910760" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-accent px-10 py-4 text-lg font-black text-primary shadow-xl transition-all duration-300 hover:scale-105 hover:bg-white">CONTÁCTANOS</a></div></section>

  <section class="bg-gray-50/80 py-16 md:py-24"><div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"><div class="mb-14 text-center"><h2 class="mb-4 text-3xl font-extrabold text-primary md:text-4xl lg:text-5xl">Aconiño agradece</h2><p class="mx-auto max-w-3xl text-base leading-relaxed text-gray-500 md:text-lg">A todos los instructores que han venido a aportarnos no solo su conocimiento y experiencia, sino también la voluntad de hacernos partícipes de su sensibilidad frente al servicio por nuestra población vulnerable.</p></div><div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">{instructorGroups.map((group, index) => <div class:list={["rounded-[2rem] border border-gray-100 bg-white px-6 py-10 text-center shadow-[0_10px_40px_rgba(0,0,0,0.03)] transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_15px_50px_rgba(0,0,0,0.08)] md:rounded-[2.5rem]", index < instructorGroups.length - 1 ? 'md:border-r-0' : '']}><h3 class="mb-6 flex min-h-[3rem] items-center justify-center px-2 text-sm font-black uppercase leading-tight tracking-widest text-primary md:text-base">{group.organization}</h3><div class="mx-auto mb-8 h-1 w-12 rounded-full bg-accent/30"></div><ul class="space-y-3">{group.instructors.map((name) => <li class="text-base font-bold text-gray-600 transition-colors duration-300 hover:text-primary">{name}</li>)}</ul></div>)}</div></div></section>
</main>
