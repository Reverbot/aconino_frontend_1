---
import { courseDetails, defaultBenefits } from '../../data/courses';

interface Props { slug: string }
const { slug } = Astro.props;
const course = courseDetails[slug] || courseDetails['concepto-bobath'];
const isFinished = course.status === 'finalizado';
---

<article class="min-h-screen bg-white">
  <header class="relative overflow-hidden bg-primary pb-24 pt-32 text-white md:pb-32 md:pt-40"><div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><a href="/cursos" class="group mb-8 inline-flex items-center gap-2 text-white/70 transition-colors hover:text-white"><span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span><span class="font-medium">Volver a cursos</span></a><div class="mx-auto max-w-4xl text-center"><span class="mb-4 block text-sm font-bold uppercase tracking-widest text-accent">Capacitación Especializada</span><h1 class="mb-8 text-3xl font-extrabold leading-tight tracking-tight md:text-5xl lg:text-7xl">{course.title}</h1>{isFinished && <span class="mb-6 inline-block rounded-full bg-red-500/90 px-5 py-2 text-sm font-black uppercase tracking-wider text-white shadow-lg">Finalizado</span>}<div class="flex flex-wrap justify-center gap-4"><div class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 px-5 py-3 backdrop-blur-md"><span class="text-accent" aria-hidden="true">▣</span><div class="text-left"><span class="block text-xs text-white/60">Fechas</span><span class="text-sm font-bold">{course.dates}</span></div></div><div class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 px-5 py-3 backdrop-blur-md"><span class="text-accent" aria-hidden="true">⌖</span><div class="text-left"><span class="block text-xs text-white/60">Ubicación</span><span class="text-sm font-bold">{course.location} {course.countryCode === 'CO' ? '🇨🇴' : ''}</span></div></div><div class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 px-5 py-3 backdrop-blur-md"><span class="text-accent" aria-hidden="true">◆</span><div class="text-left"><span class="block text-xs text-white/60">Certificación</span><span class="text-sm font-bold">Avalada por Aconiño</span></div></div></div></div></div><div class="pointer-events-none absolute inset-0 opacity-15"><div class="absolute left-1/4 top-1/4 h-80 w-80 rounded-full bg-accent blur-[120px] md:h-96 md:w-96"></div><div class="absolute bottom-1/4 right-1/4 h-80 w-80 rounded-full bg-secondary blur-[120px] md:h-96 md:w-96"></div></div></header>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24 lg:px-8"><div class="grid grid-cols-1 gap-12 lg:grid-cols-3 lg:gap-16"><div class="lg:col-span-2"><div class="relative mb-12 h-[300px] overflow-hidden rounded-3xl shadow-2xl md:h-[450px]"><img src={course.image} alt={course.title} class="h-full w-full object-cover" loading="eager" /></div><h2 class="mb-6 text-2xl font-extrabold text-primary md:text-3xl">Sobre el curso</h2>{course.description && <p class="mb-8 text-lg leading-relaxed text-gray-600">{course.description}</p>}</div><div class="relative"><div class="sticky top-32 rounded-3xl border border-gray-100 bg-gradient-to-br from-gray-50 to-white p-8 shadow-sm md:p-10"><h2 class="mb-6 text-2xl font-extrabold text-primary">Inscríbete ahora</h2><ul class="mb-8 space-y-4 text-gray-600">{defaultBenefits.map((benefit) => <li class="flex items-center gap-3"><div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/20"><div class="h-2 w-2 rounded-full bg-accent"></div></div><span class="font-medium">{benefit}</span></li>)}</ul>{isFinished ? <div class="text-center"><p class="mb-4 font-medium text-gray-400">Este curso ya finalizó</p><a href="/cursos" class="inline-block w-full rounded-2xl bg-gray-200 py-4 text-center font-bold text-gray-600 transition-all hover:bg-gray-300">Ver próximos cursos</a></div> : <a href="https://wa.me/573133910760" target="_blank" rel="noopener noreferrer" class="inline-block w-full rounded-2xl bg-primary py-5 text-center font-black text-white shadow-xl shadow-primary/20 transition-all hover:-translate-y-0.5 hover:bg-secondary hover:shadow-2xl">SOLICITAR CUPO</a>}</div></div></div></div>
</article>
