---
---

<!-- View Transitions persistence boundary so it doesn't reset on navigation -->
<div id="clinical-history-widget" transition:persist="clinical-widget" class="fixed inset-0 z-[99] flex items-center justify-center p-4 pointer-events-none sm:p-6">
  
  <!-- EXPANDED STATE (The big popup) -->
  <div id="ch-expanded" class="relative flex max-h-[calc(100dvh-2rem)] w-full max-w-3xl translate-y-[150%] transform flex-col overflow-y-auto rounded-[1.75rem] border border-primary/10 bg-white opacity-0 shadow-2xl transition-all duration-500 pointer-events-auto sm:max-h-[calc(100dvh-3rem)] sm:rounded-[2rem]" aria-live="polite">
    <div class="relative overflow-hidden p-6 sm:p-9">
      <div class="absolute top-0 right-0 w-32 h-32 bg-accent/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
      
      <button id="ch-minimize-btn" class="absolute right-3 top-3 rounded-full p-2 text-gray-400 transition-colors hover:bg-gray-100 hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2 sm:right-5 sm:top-5" aria-label="Minimizar aviso">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <div class="flex items-start gap-4 sm:gap-6">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent sm:h-16 sm:w-16">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <div class="min-w-0 pr-2 sm:pr-6">
          <h3 class="mb-3 pr-4 text-xl font-extrabold leading-tight text-primary sm:text-3xl">
            ¿Tú o tu hijo recibieron atención en ACONIÑO?
          </h3>
          <p class="mb-3 text-base leading-relaxed text-gray-600 sm:text-lg">
            Consulta el listado y verifica si el periodo de atención está incluido.
          </p>
          <p class="mb-6 text-base leading-relaxed text-gray-600 sm:text-lg">
            Si aparece, solicita una copia de la historia clínica a más tardar el <strong class="font-bold text-primary">30 de noviembre de 2026</strong>. Después de esta fecha, las historias que hayan cumplido el tiempo legal de conservación podrán ser eliminadas.
          </p>
          <a href="/historias-clinicas" class="group inline-flex w-full items-center justify-center gap-3 rounded-full bg-accent px-5 py-3.5 text-center text-sm font-bold text-primary shadow-md transition-all hover:bg-primary hover:text-white active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 sm:w-auto sm:px-7 sm:py-4 sm:text-base">
            Revisar listado y solicitar historia clínica
            <svg class="h-5 w-5 shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- MINIMIZED STATE (Small bubble above WhatsApp) -->
  <button id="ch-minimized" class="absolute bottom-[5.5rem] right-5 md:bottom-[6.5rem] md:right-8 bg-white border border-gray-200 shadow-lg rounded-full py-2 px-4 flex items-center gap-2 transform transition-all duration-500 scale-0 opacity-0 pointer-events-auto hover:bg-gray-50 active:scale-95 group" aria-label="Abrir aviso de historias clínicas">
    <div class="relative flex items-center justify-center">
      <!-- Pulsing green dot -->
      <span class="absolute flex h-2.5 w-2.5 -top-1 -right-1">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
      </span>
      <div class="text-accent">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
    </div>
    <span class="text-xs font-bold text-primary whitespace-nowrap hidden sm:block">Historias Clínicas</span>
  </button>
</div>

<script is:inline>
  // Ejecutamos la lógica principal una sola vez (gracias a transition:persist)
  // Pero necesitamos re-atar eventos si la navegación rompe algo, aunque persist lo mantiene intacto.
  const initClinicalWidget = () => {
    const widget = document.getElementById('clinical-history-widget');
    const expanded = document.getElementById('ch-expanded');
    const minimized = document.getElementById('ch-minimized');
    const minimizeBtn = document.getElementById('ch-minimize-btn');
    
    if (!expanded || !minimized || !widget) return;
    
    // Evitar reinicializar si ya se inicializó
    if (widget.dataset.initialized === "true") return;
    widget.dataset.initialized = "true";
    
    const deadline = new Date('2026-12-01T00:00:00-05:00').getTime();
    const now = new Date().getTime();

    // Si ya pasó la fecha, forzar oculto total y no hacer nada más
    if (now > deadline) {
      widget.style.display = 'none';
      return;
    }

    const showExpanded = () => {
      // Ocultar min
      minimized.classList.remove('scale-100', 'opacity-100');
      minimized.classList.add('scale-0', 'opacity-0');
      
      // Mostrar exp
      expanded.classList.remove('translate-y-[150%]', 'opacity-0');
      expanded.classList.add('translate-y-0', 'opacity-100');
      
      sessionStorage.setItem('ch_widget_state', 'expanded');
    };

    const showMinimized = () => {
      // Ocultar exp
      expanded.classList.remove('translate-y-0', 'opacity-100');
      expanded.classList.add('translate-y-[150%]', 'opacity-0');
      
      // Mostrar min
      minimized.classList.remove('scale-0', 'opacity-0');
      minimized.classList.add('scale-100', 'opacity-100');
      
      sessionStorage.setItem('ch_widget_state', 'minimized');
    };

    // Comprobar estado previo en sessionStorage
    const prevState = sessionStorage.getItem('ch_widget_state');

    if (prevState === 'minimized') {
      // Iniciar minimizado directamente
      showMinimized();
    } else {
      // Iniciar expandido después de un breve delay
      setTimeout(() => {
        // Verificar que no se haya minimizado manualmente antes del timeout
        if (sessionStorage.getItem('ch_widget_state') !== 'minimized') {
          showExpanded();
          
          // Auto-minimizar después de 10 segundos
          setTimeout(() => {
            if (sessionStorage.getItem('ch_widget_state') !== 'minimized') {
              showMinimized();
            }
          }, 10000);
        }
      }, 1000);
    }

    // Eventos de click
    minimizeBtn.addEventListener('click', showMinimized);
    minimized.addEventListener('click', showExpanded);
  };

  // Astro page-load listener (se ejecuta al inicio y en cada transición, pero transition:persist protege el DOM)
  document.addEventListener('astro:page-load', initClinicalWidget);
</script>
