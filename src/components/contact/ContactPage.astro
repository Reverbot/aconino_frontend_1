---
const socialLinks = [
  { label: 'Facebook', href: 'https://web.facebook.com/AsociacionAconino/', className: 'hover:bg-blue-600', icon: 'facebook' },
  { label: 'Instagram', href: 'https://www.instagram.com/aconinoacn/', className: 'hover:bg-pink-600', icon: 'instagram' },
  { label: 'YouTube', href: 'https://www.youtube.com/@asociacionaconino1526', className: 'hover:bg-red-600', icon: 'youtube' },
  { label: 'X', href: 'https://twitter.com/aconino', className: 'hover:bg-black', icon: 'x' },
  { label: 'LinkedIn', href: 'https://co.linkedin.com/company/aconinoacn', className: 'hover:bg-blue-700', icon: 'linkedin' },
];

const sedes = [
  {
    name: 'Sede Norte',
    address: 'Calle 127 B No. 45-28 - Barrio Prado',
    phones: ['(+57) 60(1) 650 8473', '(+57) 313 391 0760'],
    email: 'asistentenorte@aconino.org',
    color: 'bg-primary',
    iconColor: 'text-white',
  },
  {
    name: 'Sede Américas',
    address: 'Calle 6 A No. 71 A - 10 - Barrio Marsella',
    phones: ['(+57) 60(1) 290 0521', '(+57) 311 476 3740'],
    email: 'asistenteamericas@aconino.org',
    color: 'bg-accent',
    iconColor: 'text-primary',
  },
];

const branches = [
  {
    name: 'Sede Norte',
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.273161392813!2d-74.05581972414169!3d4.722515095252835!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3f850239555555%3A0x6b2b7b5f5f5f5f5f!2sAsociaci%C3%B3n%20Aconi%C3%B1o%20Sede%20Norte!5e0!3m2!1ses!2sco!4v1710000000000!5m2!1ses!2sco',
  },
  {
    name: 'Sede Américas',
    mapUrl: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.7130601392813!2d-74.12581972414169!3d4.622515095252835!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e3f990239555555%3A0x6b2b7b5f5f5f5f5b!2sAsociaci%C3%B3n%20Aconi%C3%B1o%20Sede%20Am%C3%A9ricas!5e0!3m2!1ses!2sco!4v1710000000001!5m2!1ses!2sco',
  },
];
---

<main class="min-h-screen bg-white">
  <section class="relative flex w-full items-center justify-center overflow-hidden bg-gradient-to-br from-primary via-primary to-secondary py-24 pt-20 pb-12 md:pt-24 md:pb-16">
    <div class="absolute inset-0">
      <div class="absolute -left-10 top-1/4 h-40 w-40 rounded-full bg-accent/15 blur-[60px] md:-left-20 md:h-80 md:w-80 md:blur-[100px]"></div>
      <div class="absolute bottom-0 right-1/4 h-48 w-48 rounded-full bg-secondary/30 blur-[80px] md:h-96 md:w-96 md:blur-[120px]"></div>
      <div class="absolute right-0 top-1/2 h-32 w-32 rounded-full bg-white/5 blur-[50px] md:h-64 md:w-64 md:blur-[80px]"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/40 to-primary/80"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-primary/60 via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 mt-12 flex w-full max-w-3xl flex-col items-center px-4 text-center sm:px-6 lg:px-8 md:mt-0">
      <div class="mb-6 inline-flex items-center gap-2 self-center rounded-full border border-accent/30 bg-accent/15 px-4 py-1.5 backdrop-blur-sm">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-accent">Estamos para ayudarte</span>
      </div>
      <h1 class="mx-auto text-3xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl" style="text-shadow: 0 2px 20px rgba(0,0,0,0.3)">Contáctanos</h1>
      <p class="mt-5 max-w-xl text-base font-medium leading-relaxed text-white/80 drop-shadow-lg md:text-lg">¿Tienes dudas sobre nuestros programas o cursos? Ponte en contacto con nosotros hoy mismo.</p>
      <nav class="mt-8 flex items-center justify-center gap-2 text-sm text-white/50" aria-label="Migas de pan">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span>/</span>
        <a href="/contacto" class="font-semibold text-accent transition-colors hover:text-white">Contacto</a>
      </nav>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative z-20 -mt-32 grid grid-cols-1 gap-8 md:grid-cols-2">
        {sedes.map((sede) => (
          <div class="group flex h-full flex-col items-center rounded-3xl border border-gray-100 bg-white p-8 text-center shadow-xl transition-shadow duration-500 hover:shadow-2xl md:p-10">
            <div class:list={["mb-6 flex h-16 w-16 items-center justify-center rounded-2xl text-2xl shadow-lg", sede.color, sede.iconColor]}>
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
              </svg>
            </div>
            <h2 class="mb-4 text-2xl font-black uppercase tracking-tight text-primary">{sede.name}</h2>
            <p class="mb-6 font-medium text-gray-500">{sede.address}</p>
            <div class="mb-6 space-y-3">
              {sede.phones.map((phone) => (
                <div class="flex items-center justify-center gap-2 text-gray-600">
                  <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"></path>
                  </svg>
                  <span class="text-sm font-semibold">{phone}</span>
                </div>
              ))}
            </div>
            <div class="mt-auto">
              <a href={`mailto:${sede.email}`} class="group/email flex items-center gap-2 font-bold text-secondary transition-colors hover:text-accent">
                <svg class="h-4 w-4 transition-transform group-hover/email:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m3 7 9 6 9-6"></path>
                </svg>
                <span>{sede.email}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-5 lg:gap-24">
        <div class="lg:col-span-2">
          <div class="mb-6 flex items-center gap-3">
            <span class="text-sm font-bold uppercase tracking-widest text-gray-400">Aconiño</span>
            <div class="h-[2px] w-12 bg-accent"></div>
          </div>
          <h2 class="mb-8 text-4xl font-black leading-tight text-primary md:text-5xl">Contáctanos</h2>
          <p class="mb-10 text-lg leading-relaxed text-gray-600">Envíanos un correo electrónico o completa el formulario que aparece a continuación. Estaremos encantados de atenderte.</p>
          <div class="flex flex-wrap gap-4">
            {socialLinks.map((social) => (
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} class:list={["flex h-12 w-12 items-center justify-center rounded-full bg-primary text-lg text-white transition-all duration-300 hover:-translate-y-2 hover:shadow-xl", social.className]}>
                {social.icon === 'facebook' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 1.7-5 5v3H6v4h3v8h4v-8h3.3l.7-4H13V9c0-.7.3-1 1-1Z"></path></svg>}
                {social.icon === 'instagram' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none"></circle></svg>}
                {social.icon === 'youtube' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"></path></svg>}
                {social.icon === 'x' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.4L2.8 2h6.4l4.4 5.8L18.9 2Zm-1.1 17.7h1.7L8.3 4.2H6.5l11.3 15.5Z"></path></svg>}
                {social.icon === 'linkedin' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.2 3.4A2.4 2.4 0 1 1 .4 3.4a2.4 2.4 0 0 1 4.8 0ZM.7 8h4.6v14H.7V8Zm7.5 0h4.4v1.9h.1c.6-1.1 2.1-2.3 4.3-2.3 4.6 0 5.4 3 5.4 6.9V22h-4.6v-6.7c0-1.6 0-3.7-2.3-3.7s-2.7 1.8-2.7 3.6V22H8.2V8Z"></path></svg>}
              </a>
            ))}
          </div>
        </div>

        <div class="lg:col-span-3">
          <form data-contact-form class="rounded-[2rem] border border-gray-100 bg-white p-8 shadow-xl md:p-12">
            <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
              <div>
                <label for="contact-name" class="mb-2 ml-1 block text-sm font-bold text-primary">Nombres y apellidos</label>
                <input id="contact-name" name="name" type="text" required placeholder="Tu nombre completo" class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />
              </div>
              <div>
                <label for="contact-phone" class="mb-2 ml-1 block text-sm font-bold text-primary">Teléfono o celular</label>
                <input id="contact-phone" name="phone" type="tel" placeholder="Ej: 300 123 4567" class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />
              </div>
            </div>

            <div class="mb-6 grid grid-cols-1 gap-6 md:grid-cols-2">
              <div>
                <label for="contact-email" class="mb-2 ml-1 block text-sm font-bold text-primary">Correo electrónico</label>
                <input id="contact-email" name="email" type="email" required placeholder="tu@correo.com" class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />
              </div>
              <div>
                <label for="contact-subject" class="mb-2 ml-1 block text-sm font-bold text-primary">Asunto</label>
                <input id="contact-subject" name="subject" type="text" placeholder="¿En qué podemos ayudarte?" class="w-full rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />
              </div>
            </div>

            <div class="mb-10">
              <label for="contact-message" class="mb-2 ml-1 block text-sm font-bold text-primary">Mensaje</label>
              <textarea id="contact-message" name="message" rows="5" required placeholder="Cuéntanos más detalles..." class="w-full resize-none rounded-2xl border border-gray-100 bg-gray-50 px-6 py-4 text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10"></textarea>
            </div>

            <button type="submit" class="flex w-full items-center justify-center gap-3 rounded-full bg-primary px-10 py-4 text-lg font-black uppercase tracking-wider text-white transition-all duration-300 hover:bg-secondary hover:-translate-y-1 hover:shadow-xl md:w-auto">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
              Enviar Mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="overflow-hidden bg-white py-20">
    <div class="mx-auto max-w-[1600px] px-4">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {branches.map((branch) => (
          <div class="group relative h-[400px] overflow-hidden rounded-[2rem] border-4 border-white shadow-2xl md:h-[500px]">
            <div class="pointer-events-none absolute inset-0 z-10 bg-primary/10 transition-colors group-hover:bg-transparent"></div>
            <iframe src={branch.mapUrl} width="100%" height="100%" style="border: 0" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="contrast-[110%] grayscale-[20%] transition-all duration-700 group-hover:grayscale-0" title={`Mapa ${branch.name}`}></iframe>
            <div class="absolute left-6 top-6 z-20">
              <div class="rounded-full border border-white/50 bg-white/90 px-6 py-2 shadow-lg backdrop-blur-sm">
                <p class="text-sm font-black uppercase tracking-wider text-primary">{branch.name}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</main>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const contactForm = document.querySelector('[data-contact-form]');
    if (contactForm) {
      const inputs = contactForm.querySelectorAll('input[required], textarea[required], input[type="email"], input[type="tel"]');
      
      const validateInput = (input) => {
        if (input.value.trim() === '') {
          input.classList.remove('border-green-500', 'focus:border-green-500', 'focus:ring-green-500/20', 'border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
          return;
        }
        
        let isValid = input.checkValidity();
        
        // Custom phone validation (optional)
        if (input.type === 'tel' && input.value.trim() !== '') {
          const phoneRegex = /^[0-9+\-\s()]{7,15}$/;
          isValid = phoneRegex.test(input.value);
        }

        if (isValid) {
          input.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
          input.classList.add('border-green-500', 'focus:border-green-500', 'focus:ring-green-500/20');
        } else {
          input.classList.remove('border-green-500', 'focus:border-green-500', 'focus:ring-green-500/20');
          input.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-500/20');
        }
      };

      inputs.forEach(input => {
        input.addEventListener('input', () => validateInput(input));
        input.addEventListener('blur', () => validateInput(input));
      });
    }
  });
</script>
