<script is:inline>
  (() => {
    const button = document.querySelector('[data-copy-account]');
    const status = document.querySelector('[data-copy-status]');
    const label = button?.querySelector('[data-copy-label]');
    const account = button?.getAttribute('data-account-number');
    if (!button || !status || !label || !account) return;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(account);
        label.textContent = 'Cuenta copiada';
        status.textContent = 'El número de cuenta quedó copiado en el portapapeles.';
      } catch {
        status.textContent = 'Selecciona y copia el número de cuenta manualmente.';
      }
    });
  })();
</script>
