---
interface DocumentoLegal {
  id: string;
  titulo: string;
  archivoUrl?: string;
  enlaceExterno?: string;
  descripcion?: string;
}

interface Props {
  titulo: string;
  subtitulo: string;
  descripcion: string;
  categoria: string;
  documentos: DocumentoLegal[];
  icono: string;
}

const { titulo, subtitulo, descripcion, categoria, documentos, icono } = Astro.props;

const categorias = [
  { key: 'esal', titulo: 'Permanencia ESAL', icono: '🏛️', ruta: '/permanencia-esal' },
  { key: 'transparencia', titulo: 'Transparencia', icono: '📋', ruta: '/transparencia' },
  { key: 'proteccion_datos', titulo: 'Protección de Datos Personales', icono: '🔒', ruta: '/privacidad' },
];
---

<section class="min-h-screen bg-white py-16 md:py-24">
  <div class="mx-auto max-w-4xl px-6 md:px-12 lg:px-16">
    <div class="mb-12">
      <a href="/" class="mb-6 flex items-center gap-1 text-sm text-accent transition-colors hover:underline">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 19-7-7 7-7"></path></svg>
        Volver al inicio
      </a>

      <div class="mb-4 flex items-center gap-4">
        <span class="text-4xl" aria-hidden="true">{icono}</span>
        <div>
          <h1 class="text-3xl font-black text-primary md:text-4xl">{titulo}</h1>
          <p class="text-sm font-semibold uppercase tracking-wide text-accent">{subtitulo}</p>
        </div>
      </div>

      <p class="text-lg leading-relaxed text-gray-600">{descripcion}</p>
    </div>

    {documentos.length === 0 ? (
      <div class="rounded-2xl bg-gray-50 p-12 text-center">
        <div class="mb-4 text-5xl" aria-hidden="true">📄</div>
        <h2 class="mb-2 text-xl font-bold text-primary">Próximamente</h2>
        <p class="text-gray-500">Los documentos de esta sección estarán disponibles pronto.</p>
      </div>
    ) : (
      <div class="space-y-4">
        {documentos.map((doc) => {
          const href = doc.enlaceExterno || doc.archivoUrl || '#';
          const hasLink = Boolean(doc.enlaceExterno || doc.archivoUrl);
          return (
            <div class="group rounded-xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-accent/40 hover:shadow-lg">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <h2 class="text-lg font-bold text-primary transition-colors group-hover:text-accent">{doc.titulo}</h2>
                  {doc.descripcion && <p class="mt-1 text-sm text-gray-500">{doc.descripcion}</p>}
                </div>
                {hasLink && (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-accent/10 px-4 py-2 text-sm font-semibold text-accent transition-all duration-300 hover:bg-accent hover:text-white">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0-3-3m3 3 3-3m2 8H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z"></path></svg>
                    Ver documento
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    )}

    <div class="mt-12 border-t border-gray-200 pt-8">
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-primary">Otras secciones</h2>
      <div class="flex flex-wrap gap-3">
        {categorias.filter((item) => item.key !== categoria).map((item) => (
          <a href={item.ruta} class="inline-flex items-center gap-2 rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-primary transition-all hover:bg-accent/10 hover:text-accent">
            <span aria-hidden="true">{item.icono}</span>
            {item.titulo}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
