---

<aside data-clinical-history-banner class="relative z-30 bg-accent text-primary shadow-[0_4px_16px_rgba(12,32,112,0.12)]" aria-label="Aviso sobre historias clínicas">
  <a href="/historias-clinicas" class="group mx-auto flex w-full max-w-7xl items-center justify-center gap-3 px-4 py-3 text-center text-xs font-extrabold leading-snug transition-colors hover:bg-primary hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-[-3px] sm:px-6 sm:py-3.5 sm:text-sm md:px-8">
    <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
    </svg>
    <span>Revisa el listado y solicita la historia clínica de tu hijo antes del 19 de septiembre.</span>
    <svg class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="m9 5 7 7-7 7" />
    </svg>
  </a>
</aside>

<script is:inline>
  (() => {
    const hideExpiredClinicalHistoryBanner = () => {
      const banner = document.querySelector('[data-clinical-history-banner]');
      if (!banner) return;

      const deadline = new Date('2026-09-20T00:00:00-05:00').getTime();
      if (Date.now() >= deadline) banner.remove();
    };

    hideExpiredClinicalHistoryBanner();
    document.addEventListener('astro:page-load', hideExpiredClinicalHistoryBanner);
  })();
</script>
