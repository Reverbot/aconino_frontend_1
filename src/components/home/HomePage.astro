---
const stats = [
  { value: '36', unit: 'años', label: 'transformando vidas', icon: 'child' },
  { value: '150+', unit: 'niños', label: 'atendidos cada año', icon: 'calendar' },
  { value: '5.000+', unit: 'sesiones', label: 'terapéuticas al año', icon: 'hands' },
];

const impactStats = [
  { value: '150', suffix: '+', label: 'Niños atendidos', icon: 'child' },
  { value: '25', suffix: '', label: 'Años de servicio', icon: 'calendar' },
  { value: '5000', suffix: '+', label: 'Sesiones anuales', icon: 'hands' },
];

const principles = [
  { title: 'Intervención interdisciplinaria', description: 'Coordinación entre fisioterapia, terapia ocupacional, fonoaudiología y psicología.', icon: 'handshake' },
  { title: 'Centrada en el usuario y familia', description: 'Trabajo conjunto entre profesionales, paciente y núcleo familiar en todo el proceso.', icon: 'users' },
  { title: 'Objetivos funcionales', description: 'Trabajamos habilidades que permiten mayor independencia en actividades diarias.', icon: 'target' },
  { title: 'Atención personalizada', description: 'Diseñamos el tratamiento específicamente para cada usuario tras evaluación.', icon: 'person' },
];

const programs = [
  { title: 'Atención Temprana', description: 'Programa especializado para la primera infancia.', category: '0 a 3 años', image: '/images/programa-atencion-temprana.jpg', icon: 'heart', link: '/programas#atencion-temprana' },
  { title: 'Atención a niños y jóvenes', description: 'Tratamientos especializados bajo el modelo contemporáneo de neurodesarrollo.', category: 'Niños y Jóvenes', image: '/images/programa-neurodesarrollo.jpg', icon: 'walk', link: '/programas#atencion-ninos-jovenes' },
  { title: 'Apoyo a dificultades en el aprendizaje', description: 'Intervención integral para niños con retos pedagógicos.', category: '3 a 14 años', image: '/images/programa-aprendizaje.jpg', icon: 'book', link: '/programas#apoyo-aprendizaje' },
  { title: 'Protocolo Intensivo PediaSuit', description: 'Terapia intensiva con traje ortopédico dinámico.', category: 'Terapia Intensiva', image: '/images/programa-pediasuit.jpg', icon: 'brain', link: '/programas#pediasuit' },
];

const stories = [
  { name: 'M.', story: 'Gracias a las terapias, M. ha logrado dar sus primeros pasos independientes.', image: '/images/programa-atencion-temprana.jpg' },
  { name: 'J.', story: 'El programa Pediasuit transformó la calidad de vida de toda nuestra familia.', image: '/images/programa-pediasuit.jpg' },
  { name: 'S.', story: 'Verlo sonreír y jugar con otros niños es el mayor regalo que pudimos recibir.', image: '/images/programa-neurodesarrollo.jpg' },
];

const recognitions = [
  { title: 'Fundación Aflora', meta: 'Noviembre de 2017', image: '/images/reconocimiento-aflora.png' },
  { title: 'Comisión Segunda Constitucional', meta: 'Diciembre de 2025', image: '/images/reconocimiento-comision.png' },
  { title: 'Compensar', meta: 'Noviembre 2017', image: '/images/reconocimiento-compensar.png' },
  { title: 'Concejo de Bogotá', meta: 'Cruz de Oro', image: '/images/reconocimiento-concejo.png' },
];

const iconPaths = {
  child: '<circle cx="12" cy="5" r="2.5"></circle><path d="M8 21v-5l2-4 2 3 2-3 2 4v5M7 11l3-2m4 0 3 2"></path>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 9h18"></path>',
  hands: '<path d="M7 11.5 3.5 15a2 2 0 0 0 0 2.8l2.7 2.7a2 2 0 0 0 2.8 0l3-3"></path><path d="m9 13 2.2-2.2a2 2 0 0 1 2.8 0l3.5 3.5"></path><path d="m14 8 1.5-1.5a2 2 0 0 1 2.8 0l2.2 2.2a2 2 0 0 1 0 2.8l-1 1"></path>',
  handshake: '<path d="m4 12 3-3 4 1 2-2 3 1 4 3-2 2-3-2-2 2-3-2-3 3-3-3 3-3Z"></path><path d="m7 9 2-3 3 2M16 9l1-3 3 2"></path>',
  users: '<circle cx="9" cy="8" r="3"></circle><path d="M3 20a6 6 0 0 1 12 0M16 5.5a3 3 0 0 1 0 5.8M17 14a5 5 0 0 1 4 5"></path>',
  target: '<circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="4"></circle><circle cx="12" cy="12" r="1"></circle>',
  person: '<circle cx="12" cy="7" r="3"></circle><path d="M5 21a7 7 0 0 1 14 0"></path>',
  heart: '<path d="M20.8 8.7c0 5.5-8.8 10.1-8.8 10.1S3.2 14.2 3.2 8.7A4.7 4.7 0 0 1 12 6.4a4.7 4.7 0 0 1 8.8 2.3Z"></path>',
  walk: '<circle cx="13" cy="4" r="2"></circle><path d="m11 8 3 3 3-2M10 8l-2 5 3 2 1 5M13 11l-1 4 4 3M8 13l-3 5M17 9l3 3"></path>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Z"></path><path d="M4 18a2.5 2.5 0 0 1 2.5-2.5H20M8 7h7M8 10h5"></path>',
  brain: '<path d="M9 4.5A3 3 0 0 0 6 7.5v.2A3.2 3.2 0 0 0 4 10.7a3.3 3.3 0 0 0 2 3.1v.7a3 3 0 0 0 3 3h.5V5.5a1 1 0 0 0-.5-1Z"></path><path d="M15 4.5a3 3 0 0 1 3 3v.2a3.2 3.2 0 0 1 2 3 3.3 3.3 0 0 1-2 3.1v.7a3 3 0 0 1-3 3h-.5V5.5a1 1 0 0 1 .5-1Z"></path><path d="M9.5 8h-2M9.5 12h-3M14.5 8h2M14.5 12h3M12 5v14"></path>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"></circle>',
  facebook: '<path d="M14 21v-8h3l.5-3H14V8.2c0-.9.3-1.5 1.6-1.5H18V4.1c-.4-.1-1.3-.1-2.4-.1C13 4 11 5.5 11 8.3V10H8v3h3v8"></path>',
  whatsapp: '<path d="M20.5 11.5a8.5 8.5 0 0 1-12.5 7.4L3 20l1.3-4.7A8.5 8.5 0 1 1 20.5 11.5Z"></path><path d="M9 8.5c.2-.2.4-.2.6.1l.7 1.3c.1.2.1.4-.1.6l-.5.5c.5.9 1.2 1.6 2.2 2.1l.5-.5c.2-.2.4-.2.6-.1l1.3.6c.2.1.3.3.2.5-.2.8-.8 1.2-1.5 1.2-2.7-.1-4.5-2.4-5.5-3.8-.6-1-.8-2.1-.5-2.5l.5-.4Z"></path>',
};

const svg = (name: keyof typeof iconPaths) => iconPaths[name];
---

<div class="w-full">
  <section class="relative flex min-h-[78vh] w-full flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 z-0"><video class="absolute inset-0 h-full w-full object-cover" autoplay loop muted playsinline poster="/images/hero-background-blue.png"><source src="/videos/hero-banner.mp4" type="video/mp4" /></video><div class="absolute inset-0 z-10 bg-gradient-to-b from-primary/70 via-primary/40 to-primary/80"></div><div class="absolute inset-0 z-10 bg-gradient-to-r from-primary/60 via-transparent to-transparent"></div></div>
    <div class="relative z-20 flex flex-1 items-center"><div class="mx-auto w-full max-w-7xl px-6 py-12 md:px-12 md:py-16 lg:px-16"><div class="max-w-3xl"><div class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/15 px-4 py-1.5 backdrop-blur-sm"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span><span class="text-xs font-bold uppercase tracking-widest text-accent">ONG Colombiana · Desde 1990</span></div><h1 class="text-3xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl" style="text-shadow: 0 2px 20px rgba(0,0,0,0.3)">Transformando vidas <span class="text-accent">una terapia</span> a la vez.</h1><p class="mt-5 max-w-xl text-base font-medium leading-relaxed text-white/80 md:text-lg">Hoy seguimos soñando y trabajando por un nuevo paso: un Centro Día para adultos.</p><div class="mt-8 flex flex-wrap items-center gap-3"><a href="/apoyanos" class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-bold tracking-wide text-primary shadow-lg shadow-accent/30 transition-all hover:bg-white hover:shadow-xl active:scale-[0.97]"><svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84Z"></path></svg>Apóyanos</a><a href="/quienes-somos/nosotros" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:border-white/40 hover:bg-white/20 active:scale-[0.97]">Conoce nuestra historia<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13.5 4.5 7.5 7.5-7.5 7.5M21 12H3"></path></svg></a></div></div></div></div>
    <div class="relative z-20 w-full"><div class="mx-auto max-w-7xl px-6 pb-6 md:px-12 md:pb-8 lg:px-16"><div class="inline-flex flex-wrap gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-2xl backdrop-blur-md">{stats.map((stat) => <div class="group flex min-w-[120px] flex-col items-center justify-center px-8 py-4 transition-colors hover:bg-white/10"><div class="flex items-baseline gap-1"><span class="text-2xl font-black leading-none text-accent md:text-3xl">{stat.value}</span><span class="ml-1 text-xs font-bold uppercase tracking-wide text-white/60">{stat.unit}</span></div><span class="mt-1 text-center text-[10px] font-medium leading-tight text-white/50 md:text-xs">{stat.label}</span></div>)}</div></div></div>
    <div class="absolute bottom-4 right-8 z-20 hidden flex-col items-center gap-1.5 md:flex" aria-hidden="true"><span class="translate-x-3 rotate-90 text-[9px] font-bold uppercase tracking-[0.2em] text-white/30">scroll</span><div class="h-10 w-px bg-gradient-to-b from-white/0 via-white/30 to-white/0"></div></div>
  </section>

  <section class="relative w-full overflow-hidden bg-white py-24 md:py-32"><div class="pointer-events-none absolute left-1/2 top-0 h-full w-full max-w-7xl -translate-x-1/2"><div class="absolute right-0 top-0 h-[600px] w-[600px] rounded-full bg-blue-50 opacity-60 blur-[120px]"></div><div class="absolute bottom-0 left-0 h-[500px] w-[500px] rounded-full bg-accent/10 opacity-40 blur-[100px]"></div></div><div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="mb-12 grid grid-cols-1 items-end gap-8 lg:mb-24 lg:grid-cols-12 lg:gap-20"><div class="lg:col-span-8"><span class="mb-4 block text-sm font-bold uppercase tracking-widest text-accent md:mb-6 md:text-base">Nuestro Enfoque</span><h2 class="text-3xl font-extrabold leading-[1.1] tracking-tight text-primary md:text-4xl lg:text-5xl">Nos centramos más en la actividad y menos en la discapacidad</h2></div><div class="lg:col-span-4"><p class="border-accent text-lg font-medium leading-relaxed text-slate-500 md:text-xl lg:border-l-4 lg:pl-8">En Aconiño trabajamos desde un enfoque interdisciplinario centrado en el niño y su familia, promoviendo el desarrollo integral, la autonomía y la participación social.</p></div></div><div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-8 lg:grid-cols-4">{principles.map((principle) => <div class="group flex h-full flex-col items-start overflow-hidden rounded-[2rem] border border-slate-100 bg-white p-6 shadow-[0_5px_20px_rgba(0,0,0,0.02)] transition-all duration-500 hover:-translate-y-2 hover:shadow-xl md:rounded-[3rem] md:p-10"><div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl border border-blue-100/50 bg-blue-50 shadow-sm md:mb-8 md:h-20 md:w-20 md:rounded-3xl"><svg viewBox="0 0 24 24" class="h-8 w-8 text-primary md:h-10 md:w-10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg(principle.icon as keyof typeof iconPaths)}></svg></div><h3 class="mb-3 text-lg font-extrabold uppercase leading-tight tracking-tight text-primary md:mb-4 md:text-xl">{principle.title}</h3><p class="text-sm font-medium leading-relaxed text-slate-500 md:text-base">{principle.description}</p></div>)}</div><div class="mt-12 text-center md:mt-16"><a href="https://wa.me/573133910760" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-full bg-accent px-12 py-5 text-sm font-bold tracking-widest text-primary shadow-xl shadow-accent/20 transition-all hover:-translate-y-1 hover:scale-105 hover:bg-primary hover:text-white md:text-base"><svg viewBox="0 0 24 24" class="h-5 w-5 md:h-6 md:w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg('whatsapp')}></svg>CONTÁCTANOS</a></div></div></section>

  <section class="relative w-full overflow-hidden bg-[#F8FAFC] py-24 md:py-32"><div class="pointer-events-none absolute inset-0"><div class="absolute -right-[5%] -top-[10%] h-[600px] w-[600px] rounded-full bg-primary/5 blur-[120px]"></div><div class="absolute -left-[5%] top-[40%] h-[500px] w-[500px] rounded-full bg-accent/5 blur-[100px]"></div></div><div class="relative z-10 mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8"><div class="mb-16 text-center md:mb-20"><div class="mx-auto mb-4 h-1 w-12 rounded-full bg-accent"></div><h2 class="text-3xl font-extrabold tracking-tight text-primary md:text-5xl lg:text-6xl">Nuestros Programas</h2><p class="mx-auto mt-4 max-w-2xl text-base text-slate-500 md:text-lg">Programas terapéuticos especializados para el desarrollo integral de niños y jóvenes</p></div><div class="grid grid-cols-2 items-stretch gap-4 md:grid-cols-2 md:gap-8 lg:grid-cols-4">{programs.map((program) => <div class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/60 bg-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgb(0,0,0,0.12)] md:rounded-[2rem]"><div class="relative h-40 overflow-hidden bg-slate-100 md:h-64 xl:h-72"><img src={program.image} alt={program.title} class="h-full w-full object-cover transition-transform duration-700 md:group-hover:scale-105" loading="lazy" /><div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent opacity-80"></div><div class="absolute left-3 right-10 top-3 z-10 md:left-4 md:right-12 md:top-4"><div class="inline-block rounded-xl border border-white/20 bg-white/95 px-3 py-1.5 shadow-lg backdrop-blur-md md:px-4 md:py-2"><h3 class="text-[9px] font-bold uppercase leading-none tracking-tight text-primary md:text-sm">{program.title}</h3></div></div></div><div class="relative flex flex-1 flex-col bg-white p-4 md:p-8"><div class="absolute -right-4 -top-8 flex h-10 w-10 items-center justify-center rounded-xl bg-accent shadow-[0_10px_25px_rgba(255,182,18,0.3)] md:-right-10 md:-top-12 md:h-16 md:w-16 md:rounded-2xl"><svg viewBox="0 0 24 24" class="h-5 w-5 text-white md:h-8 md:w-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg(program.icon as keyof typeof iconPaths)}></svg></div><span class="mb-4 text-sm font-extrabold uppercase tracking-widest text-slate-400 md:mb-6 md:text-lg">{program.category}</span><p class="line-clamp-3 text-[10px] leading-relaxed text-slate-600 md:line-clamp-4 md:text-[13px]">{program.description}</p><a href={program.link} class="mt-auto inline-flex items-center gap-1.5 pt-4 text-[10px] font-bold uppercase tracking-wider text-accent transition-all hover:gap-2.5 md:text-sm">Leer más <span aria-hidden="true">→</span></a></div></div>)}</div><div class="mt-12 text-center md:mt-16"><a href="/programas" class="inline-block rounded-full bg-accent px-12 py-5 text-sm font-bold tracking-widest text-primary shadow-xl shadow-accent/20 transition-all hover:-translate-y-1 hover:scale-105 hover:bg-primary hover:text-white md:text-base">NUESTROS PROGRAMAS</a></div></div><div class="pointer-events-none absolute left-0 top-1/2 hidden -ml-24 -translate-y-1/2 select-none opacity-[0.02] lg:block"><span class="text-[28rem] font-black leading-none tracking-tighter text-[#0a1f44]">ACN</span></div></section>

  <section class="relative overflow-hidden bg-white py-24 md:py-32"><div class="pointer-events-none absolute -mr-16 -mt-16 right-0 top-0 h-96 w-96 rounded-full bg-accent/5 opacity-50 blur-[100px]"></div><div class="pointer-events-none absolute -mb-16 -ml-16 bottom-0 left-0 h-80 w-80 rounded-full bg-secondary/5 opacity-50 blur-[100px]"></div><div class="relative z-10 mx-auto max-w-[1400px] px-6 sm:px-6 lg:px-8"><div class="mb-16 text-center md:mb-20"><div class="mb-6 flex items-center justify-center gap-4"><div class="h-[2px] w-12 bg-accent md:w-16"></div><span class="text-sm font-bold uppercase tracking-[0.2em] text-gray-400">Comunidad aconiño</span><div class="h-[2px] w-12 bg-accent md:w-16"></div></div><h2 class="mb-6 text-3xl font-extrabold leading-[1.1] tracking-tight text-primary md:text-4xl lg:text-5xl">ESTAMOS GENERANDO IMPACTO</h2><p class="mx-auto max-w-2xl text-center text-base font-medium leading-relaxed text-slate-500 md:text-lg">Trabajamos cada día para transformar vidas, generando impacto en nuestra población con discapacidad y demostrando que la verdadera inclusión nace cuando vemos capacidades, no limitaciones.</p></div><div class="mb-10 grid grid-cols-2 gap-4 md:mb-12 md:grid-cols-3 md:gap-6">{impactStats.map((stat, index) => <div class:list={["group flex flex-col items-center justify-center rounded-2xl border border-gray-100/50 bg-gray-50 p-5 text-center shadow-sm transition-shadow hover:shadow-md md:rounded-3xl md:p-6", index === 2 ? 'col-span-2 mx-auto w-full max-w-[calc(50%-8px)] md:col-span-1 md:max-w-none' : '']}><div class="mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-white text-xl text-secondary shadow-sm transition-transform group-hover:scale-110 md:h-14 md:w-14 md:text-2xl"><svg viewBox="0 0 24 24" class="h-5 w-5 md:h-7 md:w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg(stat.icon as keyof typeof iconPaths)}></svg></div><div class="mb-1 flex items-baseline justify-center text-2xl font-black text-primary md:text-4xl"><span>{stat.value}</span><span class="ml-0.5 text-lg text-accent md:text-3xl">{stat.suffix}</span></div><p class="text-[10px] font-bold uppercase leading-tight tracking-widest text-gray-400 md:text-lg">{stat.label}</p></div>)}</div><div class="mb-8 grid w-full grid-cols-1 gap-4 md:mb-12 md:grid-cols-3 md:gap-6">{stories.map((story) => <div class="group relative h-[260px] max-w-[280px] overflow-hidden rounded-2xl border border-gray-100 shadow-md md:h-[300px] md:max-w-none"><img src={story.image} alt={`Historia de ${story.name}`} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /><div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/30 to-transparent"></div><div class="absolute bottom-0 left-0 right-0 z-10 p-5 text-white md:p-6"><h3 class="mb-1 text-lg font-bold leading-tight md:text-2xl">{story.name}</h3><p class="line-clamp-3 text-xs font-medium italic leading-snug opacity-85 md:text-sm">“{story.story}”</p></div></div>)}</div><div class="mt-12 flex justify-center md:mt-16"><div class="group relative"><div class="pointer-events-none absolute -top-14 left-1/2 hidden -translate-x-1/2 whitespace-nowrap rounded-full border-2 border-primary/90 bg-primary px-5 py-2.5 text-sm font-bold uppercase tracking-widest text-accent shadow-[0_10px_25px_rgba(12,32,112,0.3)] group-hover:block">¿Quieres donar?</div><a href="https://wa.me/573133910760" target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp" class="relative flex h-20 w-20 items-center justify-center rounded-full border-4 border-accent bg-accent text-primary shadow-[0_10px_30px_rgba(248,183,25,0.4)] transition-all hover:scale-105 hover:bg-primary hover:text-accent active:scale-[0.97] md:h-28 md:w-28"><svg viewBox="0 0 24 24" class="h-10 w-10 md:h-12 md:w-12" fill="none" stroke="currentColor" stroke-width=