---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { blogCategories, formatBlogDate } from '../../data/blog';

interface Props { entry: CollectionEntry<'blog'>; slug: string; }
const { entry, slug } = Astro.props;

const allPosts = await getCollection('blog');
const recentPosts = allPosts.filter((item) => item.id !== entry.id);
---

<article class="relative min-h-screen overflow-hidden bg-slate-50">
  <div class="fixed top-0 left-0 w-full h-1.5 z-50 bg-transparent">
    <div id="reading-progress" class="h-full bg-accent w-0 transition-all duration-150 ease-out"></div>
  </div>
  <div class="pointer-events-none absolute inset-0 z-0 opacity-40" style="background-image: radial-gradient(#cbd5e1 0.5px, transparent 0.5px); background-size: 24px 24px"></div>
  <header class="relative overflow-hidden bg-primary pb-16 pt-28 text-white md:pb-20 md:pt-36">
    <div class="pointer-events-none absolute inset-0 overflow-hidden"><div class="absolute -left-20 top-1/4 h-80 w-80 rounded-full bg-accent/15 blur-[100px]"></div><div class="absolute bottom-0 right-1/4 h-96 w-96 rounded-full bg-secondary/30 blur-[120px]"></div></div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a href="/blog" class="group mb-8 inline-flex items-center gap-2 text-white/60 transition-colors hover:text-white"><span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span><span class="font-medium">Volver al blog</span></a>
      <div class="mb-6 flex items-center gap-4 text-sm text-white/60"><span class="inline-flex items-center gap-1.5"><svg class="h-3 w-3 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg><time datetime={entry.data.publishedAt.toString()}>{formatBlogDate(entry.data.publishedAt.toString())}</time></span><span>·</span><span class="inline-flex items-center gap-1.5"><svg class="h-3 w-3 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0h14Z"></path></svg>Asociación Aconiño</span></div>
      <h1 class="text-3xl font-extrabold leading-tight md:text-5xl lg:text-6xl" transition:name={`blog-title-${slug}`}>{entry.data.title}</h1>
    </div>
  </header>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-20 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <div class="relative -mt-12 mb-10 h-[300px] overflow-hidden rounded-3xl shadow-2xl md:-mt-16 md:h-[450px]" transition:name={`blog-image-${slug}`}><Image src={entry.data.image} alt={entry.data.imageAlt} class="h-full w-full object-cover" loading="eager" decoding="async" /></div>
        <div class="prose prose-lg max-w-none">
          <slot />
        </div>
        <div class="mt-12 border-t border-gray-200 pt-8">
          <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <h3 class="text-lg font-bold text-primary">Compartir artículo:</h3>
            <div class="flex flex-wrap gap-2">
              <button onclick="window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(window.location.href)}`, '_blank')" class="kowalski-btn inline-flex items-center gap-2 rounded-full bg-[#1877F2]/10 px-4 py-2 text-sm font-bold text-[#1877F2] transition-colors hover:bg-[#1877F2] hover:text-white">
                Facebook
              </button>
              <button onclick="window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(window.location.href)}&text=${encodeURIComponent(document.title)}`, '_blank')" class="kowalski-btn inline-flex items-center gap-2 rounded-full bg-[#1DA1F2]/10 px-4 py-2 text-sm font-bold text-[#1DA1F2] transition-colors hover:bg-[#1DA1F2] hover:text-white">
                X (Twitter)
              </button>
              <button onclick="window.open(`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(window.location.href)}&title=${encodeURIComponent(document.title)}`, '_blank')" class="kowalski-btn inline-flex items-center gap-2 rounded-full bg-[#0A66C2]/10 px-4 py-2 text-sm font-bold text-[#0A66C2] transition-colors hover:bg-[#0A66C2] hover:text-white">
                LinkedIn
              </button>
              <button onclick="window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(document.title + ' - ' + window.location.href)}`, '_blank')" class="kowalski-btn inline-flex items-center gap-2 rounded-full bg-[#25D366]/10 px-4 py-2 text-sm font-bold text-[#25D366] transition-colors hover:bg-[#25D366] hover:text-white">
                WhatsApp
              </button>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <a href="/blog" class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white transition-all hover:bg-secondary"><span aria-hidden="true">←</span>Volver al blog</a>
          </div>
        </div>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-36 lg:self-start">
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><form action="/blog" method="GET" class="relative"><label for="article-search" class="sr-only">Buscar artículos</label><input id="article-search" type="search" name="s" placeholder="Buscar artículos..." class="w-full rounded-xl border border-gray-100 bg-gray-50 px-4 py-3 pr-10 text-sm text-gray-700 outline-none transition-all placeholder:text-gray-400 focus:border-primary focus:ring-2 focus:ring-primary/10" /><button type="submit" aria-label="Buscar" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></button></form></div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><h2 class="mb-5 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-primary"><span class="h-5 w-1 rounded-full bg-accent"></span>Entradas Recientes</h2><div class="space-y-4">{recentPosts.map((item) => <a href={`/blog/${item.id.replace(/\.md$/, '')}`} class="group flex items-start gap-3"><div class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-gray-100"><Image src={item.data.image} alt={item.data.imageAlt} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110" loading="lazy" decoding="async" /></div><div class="min-w-0 flex-1"><h3 class="line-clamp-2 text-sm font-semibold leading-tight text-gray-700 group-hover:text-primary">{item.data.title}</h3><time datetime={item.data.publishedAt.toString()} class="mt-1 block text-xs text-gray-400">{formatBlogDate(item.data.publishedAt.toString(), { month: 'short', day: 'numeric' })}</time></div></a>)}</div></div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm"><h2 class="mb-5 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-primary"><span class="h-5 w-1 rounded-full bg-accent"></span>Categorías</h2><div class="space-y-1">{blogCategories.map((category) => <a href={`/blog?categoria=${category.slug}`} class="block rounded-xl px-3 py-2.5 text-sm font-medium text-gray-600 transition-colors hover:bg-primary/5 hover:text-primary">{category.title}</a>)}</div></div>
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary to-secondary p-6 text-center text-white"><div class="relative z-10"><svg class="mx-auto mb-2 h-7 w-7 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-8-4.7-8-11a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 20 10c0 6.3-8 11-8 11Z"></path></svg><h2 class="mb-2 text-lg font-extrabold">¿Quieres apoyar?</h2><p class="mb-4 text-sm text-white/70">Tu aporte transforma vidas.</p><a href="/apoyanos" class="inline-block rounded-full bg-accent px-6 py-2.5 text-sm font-bold text-primary hover:bg-white">Donar ahora</a></div></div>
      </aside>
    </div>
  </div>
  <script is:inline>
    function initProgressBar() {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;
      
      const updateProgress = () => {
        const scrollPosition = window.scrollY;
        const totalHeight = document.body.scrollHeight - window.innerHeight;
        const progress = totalHeight > 0 ? (scrollPosition / totalHeight) * 100 : 0;
        progressBar.style.width = `${progress}%`;
      };
      
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
    document.addEventListener('astro:page-load', initProgressBar);
    initProgressBar();
  </script>
</article>
